.hero {
    position: relative;
    height: 100vh;
    width: 100%;
    overflow: hidden;
}

.hero video {
    position: absolute;
    width: 100%;
    height: 100%;
    object-fit: cover;
    top: 0;
    left: 0;
    z-index: 0;
}

.content {
    position: relative;
    z-index: 2;
    color: white;
    text-align: center;
    padding-top: 30vh;
}